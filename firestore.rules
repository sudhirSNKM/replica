
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Rules for Content (Movies/Shows)
    match /content/{contentId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Rules for User Accounts and Profiles
    match /userAccounts/{userAccountId} {
      allow get, list, create, update: if isOwner(userAccountId);
      
      match /userProfiles/{userProfileId} {
        allow get, list, create, update, delete: if isOwner(userAccountId);
        
        match /watchlistItems/{watchlistItemId} {
          allow get, list, create, delete: if isOwner(userAccountId);
        }
      }
    }

    // Admin Sentinel
    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow create: if isSignedIn(); // Allow self-promotion for demo/prototype setup
      allow update, delete: if false;
    }
  }
}
