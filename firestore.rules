
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isPublished() {
      return request.time >= resource.data.publishDate;
    }

    // Global Content Library
    match /content/{contentId} {
      // Users can only see content if it is published OR they are an admin
      allow get, list: if isSignedIn() && (isPublished() || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // User Identities and Nexus
    match /userAccounts/{userAccountId} {
      allow get, list, create, update: if isOwner(userAccountId);
      
      match /userProfiles/{userProfileId} {
        allow get, list, create, update, delete: if isOwner(userAccountId);
        
        match /watchlistItems/{watchlistItemId} {
          allow get, list, create, delete: if isOwner(userAccountId);
        }
      }
    }

    // Admin Clearance
    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/roles_admin/$(adminUid)); // Self-promote if empty
    }
  }
}
