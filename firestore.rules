
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        request.auth.token.email == 'admin@replica.com'
      );
    }

    // Global Content Library
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Configuration & Stats
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Identities
    match /userAccounts/{userAccountId} {
      allow get, list, create, update: if isOwner(userAccountId) || isAdmin();
      
      match /userProfiles/{userProfileId} {
        allow get, list, create, update, delete: if isOwner(userAccountId) || isAdmin();
        
        match /watchlistItems/{watchlistItemId} {
          allow get, list, create, delete: if isOwner(userAccountId) || isAdmin();
        }
      }
    }

    // Activity & Audit Logs
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isSignedIn(); 
    }

    // Admin Clearance
    match /roles_admin/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow write: if isSignedIn(); 
    }
  }
}
