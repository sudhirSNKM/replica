
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Global Content Library
    match /content/{contentId} {
      // Allow open read for development/prototype speed
      allow read, list: if true;
      allow write: if isAdmin() || true; // Temporary open write for rapid prototyping
    }

    // User Identities
    match /userAccounts/{userAccountId} {
      // Allow owners to manage their own nodes, allow admins to monitor all nodes
      allow get, list, create, update: if isOwner(userAccountId) || isAdmin();
      
      match /userProfiles/{userProfileId} {
        allow get, list, create, update, delete: if isOwner(userAccountId) || isAdmin();
        
        match /watchlistItems/{watchlistItemId} {
          allow get, list, create, delete: if isOwner(userAccountId);
        }
      }
    }

    // Admin Clearance
    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow write: if isSignedIn(); 
    }
  }
}
