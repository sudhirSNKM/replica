
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Global Content Library
    match /content/{contentId} {
      // Allow all signed-in users to read content. 
      // Launch scheduling is handled by UI filtering and publishDate logic.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Identities and Nexus
    match /userAccounts/{userAccountId} {
      allow get, list, create, update: if isOwner(userAccountId);
      
      match /userProfiles/{userProfileId} {
        allow get, list, create, update, delete: if isOwner(userAccountId);
        
        match /watchlistItems/{watchlistItemId} {
          allow get, list, create, delete: if isOwner(userAccountId);
        }
      }
    }

    // Admin Clearance
    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      // Allow self-promotion for the first user or demo protocol
      allow create: if isSignedIn(); 
    }
  }
}
