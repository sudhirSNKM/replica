
{
  "entities": {
    "UserAccount": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserAccount",
      "type": "object",
      "description": "Represents a primary user account, linked to Firebase Auth. Stores identity markers like email or phone.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "createdAt"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "A viewing profile under a UserAccount.",
      "properties": {
        "id": { "type": "string" },
        "userAccountId": { "type": "string" },
        "name": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userAccountId", "name", "avatarUrl", "createdAt"]
    },
    "Content": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Content",
      "type": "object",
      "description": "Represents a movie or show in the system.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "videoUrl": { "type": "string", "format": "uri" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "string" },
        "releaseYear": { "type": "string" },
        "quality": { "type": "string", "enum": ["4K ULTRA HDR", "1080P FULL HD", "720P HD"] }
      },
      "required": ["id", "title", "videoUrl"]
    },
    "WatchlistItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "WatchlistItem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contentId": { "type": "string" },
        "userAccountId": { "type": "string" },
        "userProfileId": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "contentId", "userAccountId", "userProfileId", "addedAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userAccounts/{userAccountId}",
        "definition": {
          "entityName": "UserAccount",
          "schema": { "$ref": "#/backend/entities/UserAccount" },
          "description": "Primary user account node."
        }
      },
      {
        "path": "/userAccounts/{userAccountId}/userProfiles/{userProfileId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Isolated profiles for a specific account."
        }
      },
      {
        "path": "/userAccounts/{userAccountId}/userProfiles/{userProfileId}/watchlistItems/{watchlistItemId}",
        "definition": {
          "entityName": "WatchlistItem",
          "schema": { "$ref": "#/backend/entities/WatchlistItem" },
          "description": "Personalized list of synchronized content."
        }
      },
      {
        "path": "/content/{contentId}",
        "definition": {
          "entityName": "Content",
          "schema": { "$ref": "#/backend/entities/Content" },
          "description": "The global cinematic library."
        }
      },
      {
        "path": "/roles_admin/{adminUid}",
        "definition": {
          "entityName": "UserAccount",
          "schema": { "$ref": "#/backend/entities/UserAccount" },
          "description": "Admin sentinel collection."
        }
      }
    ]
  }
}
