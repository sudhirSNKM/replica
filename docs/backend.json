
{
  "entities": {
    "UserAccount": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserAccount",
      "type": "object",
      "description": "Primary user account node, identified by Auth UID.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "createdAt"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "An individual viewing profile within a UserAccount.",
      "properties": {
        "id": { "type": "string" },
        "userAccountId": { "type": "string" },
        "name": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userAccountId", "name", "avatarUrl", "createdAt"]
    },
    "Content": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Content",
      "type": "object",
      "description": "Cinematic content protocol (Movie or Show).",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "videoUrl": { "type": "string", "format": "uri" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "string" },
        "releaseYear": { "type": "string" },
        "type": { "type": "string", "enum": ["movie", "show"] },
        "quality": { "type": "string", "enum": ["4K ULTRA HDR", "1080P FULL HD", "720P HD"] },
        "publishDate": { "type": "string", "format": "date-time", "description": "When this content becomes visible to users." },
        "isTrending": { "type": "boolean" },
        "isNew": { "type": "boolean" }
      },
      "required": ["id", "title", "videoUrl", "type", "publishDate"]
    },
    "WatchlistItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "WatchlistItem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contentId": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "contentId", "addedAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userAccounts/{userAccountId}",
        "definition": {
          "entityName": "UserAccount",
          "schema": { "$ref": "#/backend/entities/UserAccount" },
          "description": "Root identity node."
        }
      },
      {
        "path": "/userAccounts/{userAccountId}/userProfiles/{userProfileId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "User-defined identities."
        }
      },
      {
        "path": "/userAccounts/{userAccountId}/userProfiles/{userProfileId}/watchlistItems/{watchlistItemId}",
        "definition": {
          "entityName": "WatchlistItem",
          "schema": { "$ref": "#/backend/entities/WatchlistItem" },
          "description": "Personalized queue."
        }
      },
      {
        "path": "/content/{contentId}",
        "definition": {
          "entityName": "Content",
          "schema": { "$ref": "#/backend/entities/Content" },
          "description": "Global content protocols."
        }
      },
      {
        "path": "/roles_admin/{adminUid}",
        "definition": {
          "entityName": "UserAccount",
          "schema": { "$ref": "#/backend/entities/UserAccount" },
          "description": "Admin clearance node."
        }
      }
    ]
  }
}
